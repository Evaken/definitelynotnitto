{
  "name": "nitto1320",
  "private": true,
  "version": "0.1.0",
  "description": "Recreation of the pre-2007 Nitto 1320 Challenge browser game",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @nitto/web",
    "build": "npm run build --workspace @nitto/web",
    "preview": "npm run preview --workspace @nitto/web",
    "server": "npm run dev --workspace @nitto/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "baseline": "node scripts/baseline.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
